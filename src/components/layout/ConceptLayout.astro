---
import '../../styles/global.css';

interface Link {
  slug: string;
  title: string;
}
interface Props {
  title: string;
  slug: string;
  level: 'beginner' | 'intermediate' | 'advanced';
  minutes: number;
  summary: string;
  share?: string | undefined;
  prev?: Link | undefined;
  next?: Link | undefined;
}
const { title, slug, level, minutes, summary, share, prev, next } = Astro.props;
const card = share ?? summary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <title>{title} · Intuitive Data Science</title>
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} · Intuitive Data Science`} />
    <meta property="og:description" content={card} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={card} />
  </head>
  <body>
    <header class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4 text-sm">
      <a href="/" class="font-semibold">
        Intuitive Data Science
      </a>
    </header>

    <main class="mx-auto max-w-3xl px-4 pb-16">
      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-muted">
        <span class="rounded-full border border-grid px-2 py-0.5 capitalize">
          {level}
        </span>
        <span>{minutes} min</span>
        <span id="progress-tick" hidden aria-label="You have read this page">
          ✓ Read
        </span>
      </div>
      <h1 class="mb-2 mt-2 text-4xl font-bold leading-tight">{title}</h1>

      <article>
        <slot />
      </article>

      <nav
        aria-label="Concept navigation"
        class="mt-12 flex justify-between gap-4 text-sm"
      >
        {prev ? (
          <a href={`/concepts/${prev.slug}/`} rel="prev">
            ← {prev.title}
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={`/concepts/${next.slug}/`} rel="next">
            {next.title} →
          </a>
        ) : (
          <span />
        )}
      </nav>
    </main>

    <footer class="mx-auto max-w-3xl px-4 py-8 text-sm text-muted">
      Free, static, and open · 
      <a
        href="https://github.com/fvizpal/intuitive_data_science"
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
      >
        GitHub
      </a>
      .
    </footer>

    <script is:inline define:vars={{ slug }}>
      // Progress lives in localStorage only; fail silently if storage is unavailable.
      try {
        const key = 'ids:read';
        const read = JSON.parse(localStorage.getItem(key) || '[]');
        if (read.includes(slug)) {
          document.getElementById('progress-tick').hidden = false;
        }
        window.addEventListener('scroll', function mark() {
          const nearEnd =
            window.innerHeight + window.scrollY >= document.body.scrollHeight - 200;
          if (!nearEnd) return;
          window.removeEventListener('scroll', mark);
          if (!read.includes(slug)) {
            read.push(slug);
            localStorage.setItem(key, JSON.stringify(read));
          }
          document.getElementById('progress-tick').hidden = false;
        });
      } catch {
        /* ignore */
      }
    </script>
  </body>
</html>
