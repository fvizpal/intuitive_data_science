---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const concepts = await getCollection('concepts');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Intuitive Data Science</title>
  </head>
  <body>
    <main class="mx-auto max-w-3xl px-4 py-12">
      <h1 class="mb-2 text-4xl font-bold">Intuitive Data Science</h1>
      <p class="text-muted">Move a slider. See what the concept does.</p>
      <ul class="mt-8 list-none space-y-3 p-0">
        {concepts.map((c) => (
          <li>
            <a href={`/concepts/${c.data.slug}/`} class="font-semibold">
              {c.data.title}
            </a>
            <span class="text-muted"> — {c.data.summary}</span>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
