---
import { render } from 'astro:content';
import { getOrderedConcepts } from '../../lib/concepts';
import { trackNav } from '../../content/tracks';
import ConceptLayout from '../../components/layout/ConceptLayout.astro';
import Hook from '../../components/mdx/Hook.astro';
import Explain from '../../components/mdx/Explain.astro';
import Misconception from '../../components/mdx/Misconception.astro';
import InTheWild from '../../components/mdx/InTheWild.astro';
import RulesOfThumb from '../../components/mdx/RulesOfThumb.astro';
import MathDetails from '../../components/ui/MathDetails.astro';
import Callout from '../../components/ui/Callout.astro';

export async function getStaticPaths() {
  const concepts = await getOrderedConcepts();
  const bySlug = new Map(concepts.map((c) => [c.data.slug, c]));
  const link = (slug: string | undefined) => {
    const e = slug ? bySlug.get(slug) : undefined;
    return e ? { slug: e.data.slug, title: e.data.title } : undefined;
  };
  return concepts.map((entry) => {
    const nav = trackNav(entry.data.slug);
    return {
      params: { slug: entry.data.slug },
      props: { entry, prev: link(nav.prev), next: link(nav.next) },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, slug, level, minutes, summary, share } = entry.data;
---

<ConceptLayout {title} {slug} {level} {minutes} {summary} {share} {prev} {next}>
  <Content
    components={{
      Hook,
      Explain,
      Misconception,
      InTheWild,
      RulesOfThumb,
      MathDetails,
      Callout,
    }}
  />
</ConceptLayout>
